<mxfile host="app.diagrams.net">
    <diagram name="BionicPRO - Identity Management" id="identity-management">
        <mxGraphModel dx="2119" dy="679" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                
                <!-- Users -->
                <mxCell id="buyer" value="Покупатель протеза&lt;br&gt;[Person]" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#7d7a88;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="40" y="40" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="pilot" value="Пилот протеза&lt;br&gt;[Person]&lt;br&gt;С этого человека считываются данные" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#7d7a88;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="40" y="300" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="operator" value="Оператор производства&lt;br&gt;[Person]" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#0b3c5d;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="15" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ml" value="ML-инженер&lt;br&gt;[Person]" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#0b3c5d;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="1295" y="720" width="110" height="90" as="geometry"/>
                </mxCell>

                <!-- Frontend Applications -->
                <mxCell id="app" value="Приложение для донастройки протеза&lt;br&gt;[Container: iOS, Android]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ea7d7;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="300" y="650" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="shop" value="Интернет-магазин&lt;br&gt;[Container: Битрикс24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ea7d7;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="680" y="40" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="frontend-web" value="Frontend Web&lt;br&gt;[Container: React]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ea7d7;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="300" y="500" width="300" height="90" as="geometry"/>
                </mxCell>

                <!-- BFF and Identity Services -->
                <mxCell id="bff" value="BFF Service&lt;br&gt;[Container: SpringBoot]&lt;br&gt;&lt;br&gt;Backend for Frontend:&lt;br&gt;- OAuth 2.0 flow&lt;br&gt;- Session management&lt;br&gt;- Token handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ff6b6b;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="650" y="500" width="280" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="idp-gateway" value="Identity Provider Gateway&lt;br&gt;[Container: SpringBoot]&lt;br&gt;&lt;br&gt;- IdP abstraction&lt;br&gt;- Regional routing&lt;br&gt;- Protocol adaptation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ff6b6b;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="650" y="680" width="280" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="token-service" value="Token Service&lt;br&gt;[Container: SpringBoot]&lt;br&gt;&lt;br&gt;- Token storage&lt;br&gt;- Token refresh&lt;br&gt;- JWT issuance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ff6b6b;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="980" y="500" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="local-identity-store" value="Local Identity Store&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;br&gt;- User accounts&lt;br&gt;- IdP mappings&lt;br&gt;- User metadata" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#ff6b6b;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="980" y="680" width="240" height="120" as="geometry"/>
                </mxCell>

                <!-- Regional Identity Providers -->
                <mxCell id="keycloak-ru" value="Keycloak&lt;br&gt;[External: IdP]&lt;br&gt;Россия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4ecdc4;fontColor=#000000;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="850" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="azure-ad-eu" value="Azure AD&lt;br&gt;[External: IdP]&lt;br&gt;Европа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4ecdc4;fontColor=#000000;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="280" y="850" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="aws-cognito-us" value="AWS Cognito&lt;br&gt;[External: IdP]&lt;br&gt;США" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4ecdc4;fontColor=#000000;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="850" width="200" height="80" as="geometry"/>
                </mxCell>

                <!-- Existing Components -->
                <mxCell id="chip" value="Программа в чипе протеза&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Чтение данных с датчиков, распознавание движений и их воспроизводство. Чтение команд из приложения и их воспроизводство, передача телеметрии" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b5fa5;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="300" y="275" width="300" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="api" value="API&lt;br&gt;[Container: SpringBoot, ElasticSearch, etc.]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ea7d7;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="680" y="820" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="db" value="База данных&lt;br&gt;[Container: PostgreSQL]" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#1ea7d7;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="900" y="820" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="crm" value="CRM&lt;br&gt;[Container: Битрикс24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ea7d7;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="960" y="40" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="crmdb" value="CRM DB&lt;br&gt;[Container: Oracle Database 12]" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#1ea7d7;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="950" y="210" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="cli" value="cli tool&lt;br&gt;[Container: SpringBoot, ElasticSearch, etc.]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ea7d7;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="600" width="140" height="90" as="geometry"/>
                </mxCell>

                <!-- Edges: User to Frontend -->
                <mxCell id="e1" value="Выбор протеза, заказ, оплата" style="endArrow=block;html=1;" parent="1" source="buyer" target="shop" edge="1">
