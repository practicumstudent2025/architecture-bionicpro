                <!-- Edges: IdP Gateway to Regional IdPs -->
                <mxCell id="e9" value="OAuth 2.0" style="endArrow=block;html=1;dashed=1;" parent="1" source="idp-gateway" target="keycloak-ru" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
